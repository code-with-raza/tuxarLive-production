# Serve only the production build on Apache / cPanel.
Options -Indexes

<FilesMatch "(?i)(^\.|\.(?:env|pem|key|p12|pfx|sql|sqlite3?|db|log|bak|backup|old|orig|map|zip|rar|7z|gz|tgz|bz2|xz|tar|toml|ini|conf|lock|ps1|py|sh|tsx?|jsx|ya?ml)$|^(?:package(?:-lock)?\.json|tsconfig.*\.json|vite\.config\..*)$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never serve accidentally uploaded repository, database or release folders.
  RewriteRule ^(?:\.git|\.svn|\.hg|node_modules|src|supabase|scripts|tests|output|docs)(?:/|$) - [F,L,NC]

  # WordPress administration is forbidden before host redirects and SPA dispatch.
  RewriteRule ^wp-admin(?:/|$) - [F,L,NC]

  # Optional agent manifests must never receive the SPA HTML document.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(?:\.well-known/)?ai-catalog\.json$ - [R=404,L]

# BEGIN TUXAR LOCALE ALIASES
  # Exact former URLs only; preserve legitimate query strings.
  RewriteRule ^en/blog/come-viene-conciata-la-vera-pelle-italiana/?$ https://tuxar.co.uk/en/blog/how-real-italian-leather-is-tanned [R=301,L,NE]
