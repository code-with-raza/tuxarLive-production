  RewriteRule ^shop-the-best-mens-driving-gloves-for-australian-roads/?$ - [G,L,NC,QSD]
  RewriteRule ^taking-off-leather-jacket-from-behind-step-by-step-guide/?$ - [G,L,NC,QSD]
  RewriteRule ^top-biker-heated-gloves-for-winter-riding-comfort/?$ - [G,L,NC,QSD]
  RewriteRule ^why-mens-leather-jackets-never-go-out-of-style/?$ - [G,L,NC,QSD]
# END TUXAR WORDPRESS RETIREMENT

  # BEGIN TUXAR ROOT LANGUAGE
  # Root only: saved choice, then primary browser language, then English.
  # Temporary redirects: destination varies by visitor, not a permanent move.
  # Keep legacy query guards above this block. Campaign parameters are retained.
  RewriteCond %{HTTP:Cookie} (^|;[[:space:]]*)tuxar-locale=(en|it|de|fr|es)(;|$)
  RewriteRule ^$ https://tuxar.co.uk/%2 [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^[[:space:]]*it([-;,]|$) [NC]
  RewriteRule ^$ https://tuxar.co.uk/it [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^[[:space:]]*de([-;,]|$) [NC]
  RewriteRule ^$ https://tuxar.co.uk/de [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^[[:space:]]*fr([-;,]|$) [NC]
  RewriteRule ^$ https://tuxar.co.uk/fr [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^[[:space:]]*es([-;,]|$) [NC]
  RewriteRule ^$ https://tuxar.co.uk/es [R=302,L]
  RewriteRule ^$ https://tuxar.co.uk/en [R=302,L]
  # END TUXAR ROOT LANGUAGE

  # Keep one secure canonical host for Google and customers.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.tuxar\.co\.uk$ [NC]
  RewriteRule ^ https://tuxar.co.uk%{REQUEST_URI} [R=301,L]

  # Brands were removed in favour of Tuxar's own collection and Contact page.
  RewriteRule ^(en|it|de|fr|es)/brands(?:/.*)?$ /$1/contact [R=301,L,NC]
  RewriteRule ^brands(?:/.*)?$ /en/contact [R=301,L,NC]

  # Serve real homepage HTML without changing the public URL or its canonical.
  # END avoids reprocessing the internal file path through the SPA rules.
  RewriteCond %{THE_REQUEST} \s/+prerender-home/(en|it|de|fr|es)\.html[?\s] [NC]
  RewriteRule ^prerender-home/(en|it|de|fr|es)\.html$ https://tuxar.co.uk/$1 [R=301,L,NE]
  RewriteCond %{DOCUMENT_ROOT}/prerender-home/$1.html -f
  RewriteRule ^(en|it|de|fr|es)/?$ /server-router.php [END]

  # Public sitemap pages have their own initial HTML, language and SEO metadata.
  # Direct requests for implementation files resolve to the public URL once.
  RewriteCond %{THE_REQUEST} \s/+prerender-pages/[^?\s]+/index\.html[?\s] [NC]
  RewriteRule ^prerender-pages/((?:en|de|es|fr|it)/(?:[a-z0-9-]+/)*[a-z0-9-]+)/index\.html$ https://tuxar.co.uk/$1 [R=301,L,NE]
  # Always check current publication status before serving a product/article snapshot.
  RewriteRule ^(?:(?:en|de|fr|it|es)/)?(?:product|blog)/[a-z0-9-]+/?$ /server-router.php [END]
  RewriteCond %{DOCUMENT_ROOT}/prerender-pages/$1/index.html -f
  RewriteCond %{QUERY_STRING} !(^|&)q= [NC]
  RewriteRule ^((?:en|de|es|fr|it)/(?:[a-z0-9-]+/)*[a-z0-9-]+)/?$ /server-router.php [END]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /server-router.php [END]
</IfModule>

<Files "server-routes.json">
  Require all denied
</Files>

<IfModule mod_headers.c>
  # A cache must not pin another visitor's homepage language.
  Header always merge Vary "Accept-Language" "expr=%{REQUEST_URI} == '/'"
  Header always merge Vary "Cookie" "expr=%{REQUEST_URI} == '/'"
  Header always set Cache-Control "private, no-store" "expr=%{REQUEST_URI} == '/'"
  # Avoid duplicate headers from Apache's separate success/always tables.
  Header onsuccess unset X-Content-Type-Options
  Header onsuccess unset Referrer-Policy
  Header onsuccess unset X-Frame-Options
  Header onsuccess unset Strict-Transport-Security
  Header onsuccess unset Permissions-Policy
  Header onsuccess unset Content-Security-Policy
  Header onsuccess unset Content-Security-Policy-Report-Only
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  # Start with a reversible five-minute policy. No includeSubDomains/preload.
  Header always set Strict-Transport-Security "max-age=300"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Enforce navigation/frame protections immediately. Trial resource restrictions
  # without breaking an unverified production OAuth, upload or payment flow.
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://rest.happierleads.com https://ddwl4m2hdecbv.cloudfront.net https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://page-visits-full.happierleads.com https://tracking.happierleads.com https://session-recordings.happierleads.com https://api.country.is https://*.supabase.co wss://*.supabase.co https://api.cloudinary.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://js.stripe.com https://hooks.stripe.com; form-action 'self' https://checkout.stripe.com"

  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(?:css|js|mjs|jpg|jpeg|png|gif|svg|webp|avif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(?:index\.html|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
