# Supabase (required for Google Auth)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Google Analytics 4 (optional until deployment).
# Analytics is not loaded until a visitor explicitly accepts analytics cookies.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Set to true only after STRIPE_SECRET_KEY and SITE_URL are configured in Supabase
# and the checkout Edge Functions have been deployed and tested.
VITE_STRIPE_ENABLED=false

# Keep this false for the first production deployment. COD remains available.
# Change it to true and rebuild/redeploy the frontend only after Stripe test mode
# succeeds end-to-end through the Supabase Edge Functions.

# Set these as Supabase Edge Function secrets (never expose them as VITE_ variables):
# supabase secrets set STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_... SITE_URL=https://tuxar.co.uk
# Then deploy the create-checkout-session, verify-checkout-session, and stripe-webhook functions.
# Configure Stripe to send checkout.session.completed and checkout.session.expired
# to: https://YOUR_PROJECT_REF.supabase.co/functions/v1/stripe-webhook

# Other required Supabase Edge Function secrets used by the current application:
# RESEND_API_KEY=re_...
# AUTH_FROM_EMAIL=Tuxar <accounts@tuxar.co.uk>
# ORDERS_FROM_EMAIL=Tuxar Orders <orders@tuxar.co.uk>
# MARKETING_FROM_EMAIL=Tuxar <news@tuxar.co.uk>
# CONTACT_FROM_EMAIL=Tuxar Website <website@tuxar.co.uk>
# CONTACT_NOTIFICATION_EMAIL=tuxar.co@gmail.com
# OTP_PEPPER=generate_a_long_random_secret
# RATE_LIMIT_SECRET=generate_a_separate_long_random_secret
# ADDITIONAL_ALLOWED_ORIGINS=https://your-explicitly-trusted-staging-host.example
# ALLOW_LOCAL_ORIGINS=false
# Apply 202610170001_security_hardening.sql before deploying the Edge Functions.
# Never put server credentials in a VITE_ variable. Staff MFA is required.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# After creating the project:
# 1. Authentication → Providers → enable Google
# 2. Add Google OAuth Client ID + Secret from Google Cloud Console
# 3. Authentication → URL Configuration → add Site URL and Redirect URLs:
#    - http://localhost:5173/**
#    - https://tuxar.co.uk/**
